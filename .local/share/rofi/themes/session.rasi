// ***************** IMPORTS *****************
@import "~/.cache/wal/colors-rofi.rasi"

// ************** CONFIGURATION **************

configuration {
    show-icons:                 false;
}

// ****************** WINDOW ******************

window {
    enabled:                    true;
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      428;
    x-offset:                   0px;
    y-offset:                   0px;

    margin:                     0px;
    padding:                    18px;

    border:                     1px solid;
    border-radius:              4px;
    border-radius:              24px 4px 24px 4px;
    border-color:               @foreground;

    cursor:                     "default";
    background-color:           @background-transparent-8;
}

// ***************** MAINBOX ******************

mainbox {
    enabled:                    true;
    spacing:                    24px;
    margin:                     0px;
    padding:                    0px;

    border-radius:              0px;
    background-color:           transparent;
}

// ***************** INPUT BAR *****************

inputbar {
    enabled:                    true;
    spacing:                    8px;
    margin:                     0px;
    padding:                    0px;

    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;

    children:                   [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    enabled:                    true;
    font:                       "Symbols Nerd Font 8";
    expand:                     false;
    str:                        "";
    padding:                    12px;
    border-radius:              0px;
    background-color:           @color4;
}

prompt {
    enabled:                    true;
    font:                       "RobotoMono Nerd Font 8";
    padding:                    0px 8px;
    border-radius:              0px;

    background-color:           transparent;
    text-color:                 @foreground;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

// ***************** LISTVIEW *****************

listview {
    enabled:                    true;
    columns:                    4;
    lines:                      1;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    24px;
    margin:                     0px;
    padding:                    0px;

    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    cursor:                     "default";
}

// ****************** ELEMENTS ******************

element {
    enabled:                    true;
    spacing:                    0px;
    padding:                    22px 10px;
    margin:                     0px;

    border:                     0px solid;
    border-radius:              3px;
    border-radius:              100%;

    background-color:           @foreground-transparent-1;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element-text {
    font:                       "Symbols Nerd Font 24";
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

element selected.normal {
    background-color:           @foreground;
    text-color:                 @background;
}