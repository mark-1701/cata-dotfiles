// /* MACOS LAUNCHPAD LIKE THEME FOR ROFI */
// /* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font:                       "Montserrat 9";

    bg0:                        rgba(36, 36, 36, 0.8);
    bg1:                        #363636;
    bg2:                        #f5f5f520;
    bg3:                        #f5f5f540;
    bg4:                        #0860f2E6;

    fg0:                        #f5f5f5;
    fg1:                        #f5f5f580;

    background-color:           transparent;
    text-color:                 @fg0;
    // padding:                 0px;
    // margin:                  0px;
}

// ****************** WINDOW ******************

window {
    enabled:                    true;
    location:                   center;
    anchor:                     center;
    x-offset:                   0px;
    y-offset:                   0px;
    fullscreen:                 true;

    margin:                     0px;
    padding:                    0px;

    border:                     0px solid;
    border-radius:              0px;
    border-color:               transparent;

    background-color:           @bg0;
    cursor:                     "default";
}

// ***************** MAINBOX ******************

mainbox {
    enabled:                    true;
    spacing:                    16px;
    padding:                    28px 0px 16px;

    border:                     0px solid;
    border-radius:              0px 0px 0px 0px;
    border-color:               transparent;

    background-color:           transparent;
    children:                   [listview, inputbar];
}

// **************** INPUT BAR *****************

inputbar {
    enabled:                    true;
    margin:                     0px calc( 50% - 120px );
    padding:                    10px 4px 10px 16px;
    spacing:                    4px;

    border:                     1px;
    // border-radius:              20px;
    border-radius:              4px 4px 24px 24px;
    border-color:               @bg3;

    background-color:           @bg2;
    text-color:                 white;

    children:                   [textbox-icon, textbox-prompt-colon, entry];
}

prompt {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 inherit;
}

textbox-icon {
    enabled:                    true;
    expand:                     false;
    str:                        " ";
    text-color:                 white;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "::";

    background-color:           transparent;
    text-color:                 inherit;
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     text;

    placeholder:                "Search...";
    placeholder-color:          inherit;
}

// ***************** LISTVIEW *****************

listview {
    enabled:                    true;
    columns:                    6;
    fixed-columns:              true;

    spacing:                    48px;
    margin:                     0px calc( 50% - 560px );
    padding:                    0px;

    border:                     0px solid;
    border-radius:              0px;
    border-color:               transparent;

    background-color:           transparent;
    text-color:                 white;
    cursor:                     "default";
}

// ***************** ELEMENTS *****************

element, element-text, element-icon {
    cursor:                     pointer;
}

element {
    enabled:                    true;
    orientation:                vertical;

    spacing:                    4px;
    margin:                     0px;
    padding:                    8px;

    border:                     0px solid;
    border-radius:              16px;
    border-color:               transparent;

    background-color:           transparent;
    text-color:                 white;
}

element selected {
    background-color:           @bg4;
}

element-icon {
    enabled:                    true;
    size:                       4em;
    horizontal-align:           0.5;
}

element-text {
    enabled:                    true;
    horizontal-align:           0.5;
}
